{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 alert",
  "type": "object",
  "required": [
    "schema_version",
    "alert_id",
    "rule_id",
    "rule_version",
    "evidence_ids",
    "evidence_quality"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_quality": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Rule evidence quality",
      "type": "object",
      "required": [
        "requirements",
        "observed",
        "missing",
        "status",
        "response_eligible",
        "response_prohibited_reasons"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed": {
          "type": "object"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "complete_for_rule",
            "reduced"
          ]
        },
        "response_eligible": {
          "type": "boolean"
        },
        "response_prohibited_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
